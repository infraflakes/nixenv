{
	"$schema": "https://opencode.ai/config.json",
	"permission": {
		"*": "ask",
		"bash": "allow"
	},
	"plugin": ["opencode-snip@next", "opencode-dcp"],
	"mcp": {
		"servers": {
			"codegraph": {
				"type": "local",
				"command": ["codegraph", "serve", "--mcp"],
				"disabled": false,
				"codemode": false
			}
		}
	}
}
